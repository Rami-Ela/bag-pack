// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips          Trip[]
  itemCategories ItemCategory[]
  itemTemplates  ItemTemplate[]
  tripTemplates  TripTemplate[]
  sessions       Session[]

  @@map("users")
}

// The cookie holds a random token; only its SHA-256 is stored, so a DB leak does not leak live sessions.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Trip {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items PackingListItem[]

  @@index([userId])
  @@map("trips")
}

model ItemCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?  @default("#3B82F6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         PackingListItem[]
  templates     ItemTemplate[]
  templateItems TripTemplateItem[]

  @@index([userId])
  @@map("item_categories")
}

model ItemTemplate {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int          @default(1)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  items PackingListItem[]

  @@index([userId])
  @@index([categoryId])
  @@map("item_templates")
}

model PackingListItem {
  id          String        @id @default(cuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ItemCategory? @relation(fields: [categoryId], references: [id])
  templateId  String?
  template    ItemTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name        String
  quantity    Int           @default(1)
  notes       String?
  packed      Boolean       @default(false)
  broughtBack Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tripId])
  @@index([categoryId])
  @@index([templateId])
  @@map("packing_list_items")
}

// User-defined packing list used to prefill a new trip. Items are copied into the trip
// at creation, so editing a template never alters existing trips.
model TripTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TripTemplateItem[]

  @@index([userId])
  @@map("trip_templates")
}

// perDay=true  -> trip quantity = quantity x trip duration in days
// perDay=false -> trip quantity = quantity (fixed regardless of duration)
model TripTemplateItem {
  id         String        @id @default(cuid())
  templateId String
  template   TripTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  quantity   Int           @default(1)
  perDay     Boolean       @default(false)
  position   Int

  @@index([templateId])
  @@index([categoryId])
  @@map("trip_template_items")
}
